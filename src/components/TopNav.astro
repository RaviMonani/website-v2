---
import { site, contact, nav } from "../data/resume";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const primaryLabels = ["About", "Experience", "Research", "Projects", "Achievements"];
const primary = nav.filter((item) => primaryLabels.includes(item.label));
const more = nav.filter(
  (item) => item.label !== "Home" && item.label !== "Contact" && !primaryLabels.includes(item.label)
);
---

<header class="topnav">
  <a class="brand" href="/">
    <img src={site.photo} alt="" width="30" height="30" />
    <span>{site.name}</span>
  </a>

  <nav class="nav-links" aria-label="Primary">
    {
      primary.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }}>
          {item.label}
        </a>
      ))
    }
    <div class="more-menu">
      <button class="more-trigger" id="more-trigger" aria-expanded="false" aria-controls="more-panel">
        More <span aria-hidden="true">&#9662;</span>
      </button>
      <div class="more-panel" id="more-panel">
        {more.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </div>
  </nav>

  <a class="nav-cta" href="/contact">Book a session</a>

  <button
    class="nav-toggle"
    id="nav-toggle"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Open menu"
  >
    <span></span><span></span><span></span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu">
  <nav aria-label="Primary">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={{ active: isActive(item.href) }}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-menu-foot">
    <a class="btn btn-primary" href="/contact">Book a free session</a>
    <div class="mobile-social">
      <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={contact.googleScholar} target="_blank" rel="noopener">Scholar</a>
      <a href={`mailto:${contact.email}`}>Email</a>
    </div>
  </div>
</div>
<button class="nav-scrim" id="nav-scrim" hidden aria-hidden="true" tabindex="-1"></button>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem clamp(1.5rem, 4vw, 3.5rem);
    background: rgba(246, 244, 238, 0.82);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display, var(--font-serif));
    font-weight: 600;
    font-size: 1.08rem;
    color: var(--ink);
    flex-shrink: 0;
  }
  .brand img {
    border-radius: 50%;
    object-fit: cover;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.93rem;
    font-weight: 500;
    margin-inline: auto;
  }
  .nav-links > a {
    color: var(--ink-soft);
    transition: color var(--transition);
  }
  .nav-links > a:hover,
  .nav-links > a.active {
    color: var(--accent-strong);
  }

  .more-menu {
    position: relative;
  }
  .more-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    font: inherit;
    color: var(--ink-soft);
    cursor: pointer;
    padding: 0;
  }
  .more-trigger:hover {
    color: var(--accent-strong);
  }
  .more-panel {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 50%;
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    min-width: 220px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    padding: 0.5rem;
  }
  .more-panel.open {
    display: flex;
  }
  .more-panel a {
    padding: 0.6rem 0.85rem;
    border-radius: 7px;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .more-panel a:hover {
    background: var(--accent-tint);
    color: var(--accent-strong);
  }

  .nav-cta {
    flex-shrink: 0;
    font-size: 0.86rem;
    font-weight: 600;
    padding: 0.62rem 1.25rem;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    transition: transform var(--transition), background var(--transition);
  }
  .nav-cta:hover {
    background: var(--accent-strong);
    transform: translateY(-1px);
    color: #fff;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 10px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--ink);
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile overlay menu */
  .mobile-menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(360px, 88vw);
    background: var(--panel);
    color: var(--panel-text);
    z-index: 140;
    padding: 5.5rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(100%);
    transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }
  .mobile-menu.open {
    transform: translateX(0);
    box-shadow: var(--shadow-lg);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .mobile-menu a {
    display: block;
    padding: 0.75rem 0.5rem;
    color: var(--panel-text);
    font-weight: 500;
    border-radius: 9px;
  }
  .mobile-menu a:hover,
  .mobile-menu a.active {
    background: var(--panel-2);
    color: #fff;
  }
  .mobile-menu-foot {
    border-top: 1px solid var(--panel-line);
    padding-top: 1.5rem;
  }
  .mobile-menu-foot .btn {
    width: 100%;
  }
  .mobile-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .mobile-social a {
    color: var(--panel-muted);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0;
  }
  .mobile-social a:hover {
    color: #fff;
    background: none;
  }

  .nav-scrim {
    position: fixed;
    inset: 0;
    background: rgba(10, 12, 15, 0.5);
    border: 0;
    z-index: 130;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const moreTrigger = document.getElementById("more-trigger");
  const morePanel = document.getElementById("more-panel");
  const setMoreOpen = (open: boolean) => {
    morePanel?.classList.toggle("open", open);
    moreTrigger?.setAttribute("aria-expanded", String(open));
  };
  moreTrigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    setMoreOpen(moreTrigger.getAttribute("aria-expanded") !== "true");
  });
  document.addEventListener("click", (e) => {
    if (!moreTrigger?.contains(e.target as Node)) setMoreOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMoreOpen(false);
  });

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  const scrim = document.getElementById("nav-scrim");
  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (scrim) scrim.hidden = !open;
    document.body.style.overflow = open ? "hidden" : "";
  };
  toggle?.addEventListener("click", () =>
    setMenuOpen(toggle.getAttribute("aria-expanded") !== "true")
  );
  scrim?.addEventListener("click", () => setMenuOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenuOpen(false);
  });
</script>
