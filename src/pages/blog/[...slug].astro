---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <a class="back-link" href="/blog">Back to Tech Updates</a>
    <header class="post-header">
      <div class="chip-row">
        {post.data.tags.map((t) => <span class="chip">{t}</span>)}
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 70ch;
  }
  .back-link {
    display: inline-block;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1.75rem;
  }
  .back-link::before {
    content: "\2190  ";
  }
  .post-header {
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .post-header h1 {
    margin-top: 1rem;
  }
  .post-meta {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .prose :global(p) {
    margin-bottom: 1.15rem;
    font-size: 1.08rem;
    line-height: 1.75;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.15rem;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .prose :global(li) {
    line-height: 1.7;
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--graphite);
    font-style: italic;
  }
  .prose :global(code) {
    background: #eef0ec;
    padding: 0.1rem 0.4rem;
    border-radius: 5px;
    font-size: 0.9em;
  }
</style>
