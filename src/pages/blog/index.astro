---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title="Tech Updates"
  description="Notes and articles by Ravi Monani on processor design, hardware security, validation, and research."
>
  <PageHeader
    eyebrow="Tech Updates"
    title="Notes from the field"
    lead="Occasional writing on processor design, hardware security, validation, and the research that informs it."
  />

  {
    posts.length === 0 ? (
      <p class="text-muted">New articles are on the way - check back soon.</p>
    ) : (
      <div class="post-list">
        {posts.map((post) => (
          <article class="post-row reveal">
            <time class="post-date" datetime={post.data.date.toISOString()}>
              {fmt(post.data.date)}
            </time>
            <div class="post-main">
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p class="text-muted">{post.data.description}</p>
              <div class="chip-row post-tags">
                {post.data.tags.map((t) => <span class="chip chip-neutral">{t}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
  }
  .post-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 1.5rem;
    padding-block: 1.8rem;
    border-top: 1px solid var(--line);
  }
  .post-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .post-date {
    color: var(--accent-strong);
    font-weight: 600;
    font-size: 0.9rem;
    padding-top: 0.3rem;
  }
  .post-main h2 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .post-main h2 a {
    color: var(--ink);
  }
  .post-main h2 a:hover {
    color: var(--accent-strong);
  }
  .post-tags {
    margin-top: 0.9rem;
  }
  @media (max-width: 600px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
