---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { industryRecognition, academicHonors } from "../data/resume";

const groups = [
  { eyebrow: "Industry", heading: "Industry recognition", items: industryRecognition },
  { eyebrow: "Academic", heading: "Academic honors & memberships", items: academicHonors },
];
---

<BaseLayout
  title="Achievements"
  description="Awards, honors, and recognition earned by Ravi Monani across industry and academia, including IEEE Senior Member elevation."
>
  <PageHeader
    eyebrow="Achievements"
    title="Recognized across industry & academia"
    lead="Innovation awards, leadership recognition, academic honors, and professional memberships."
  />

  {
    groups.map((group) => (
      <section class="section">
        <div class="section-head">
          <span class="eyebrow">{group.eyebrow}</span>
          <h2>{group.heading}</h2>
        </div>
        <div class="grid grid-2">
          {group.items.map((a) => (
            <article class="award-card reveal">
              <div class="award-head">
                <h3>{a.title}</h3>
                {a.date && <span class="award-date">{a.date}</span>}
              </div>
              <p class="award-org">{a.org}</p>
              <p class="text-muted award-desc">{a.description}</p>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .award-card {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .award-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-soft);
  }
  .award-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .award-head h3 {
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .award-date {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-strong);
    white-space: nowrap;
  }
  .award-org {
    color: var(--graphite);
    font-weight: 500;
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }
  .award-desc {
    margin-top: 0.7rem;
    font-size: 0.94rem;
  }
</style>
