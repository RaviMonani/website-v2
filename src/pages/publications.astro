---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import {
  externalPublications,
  presentations,
  industryPublications,
  contact,
} from "../data/resume";

const groups = [
  {
    eyebrow: "Peer-reviewed",
    heading: "Journal & conference papers",
    items: externalPublications,
  },
  { eyebrow: "Talks", heading: "Conference presentations", items: presentations },
  { eyebrow: "Industry", heading: "Industry technical papers", items: industryPublications },
];
---

<BaseLayout
  title="Publications"
  description="Publications by Ravi Monani in hardware security, chaos-based cryptography, FPGA/CMOS design, and post-silicon validation."
>
  <PageHeader
    eyebrow="Publications"
    title="Papers, talks & technical writing"
    lead="Peer-reviewed research and industry technical papers spanning hardware security, low-power IC design, and validation."
  />

  <div class="scholar-banner reveal">
    <div>
      <h2>Full publication record</h2>
      <p class="text-muted">Citations, metrics, and the complete list are on Google Scholar.</p>
    </div>
    <a class="btn btn-primary" href={contact.googleScholar} target="_blank" rel="noopener">
      View Google Scholar
    </a>
  </div>

  {
    groups.map((group) => (
      <section class="section">
        <div class="section-head">
          <span class="eyebrow">{group.eyebrow}</span>
          <h2>{group.heading}</h2>
        </div>
        <div class="pub-grid">
          {group.items.map((p) => (
            <article class="pub-card reveal">
              <span class="pub-date">{p.date}</span>
              <h3>{p.title}</h3>
              <p class="pub-venue">{p.venue}</p>
              <p class="text-muted pub-desc">{p.description}</p>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .scholar-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.6rem 1.9rem;
    background: var(--accent-tint);
    border: 1px solid var(--accent-soft);
    border-radius: var(--radius);
  }
  .scholar-banner h2 {
    font-size: 1.35rem;
  }
  .pub-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }
  .pub-card {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .pub-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .pub-date {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-strong);
    margin-bottom: 0.55rem;
  }
  .pub-card h3 {
    font-size: 1.08rem;
    line-height: 1.3;
  }
  .pub-venue {
    color: var(--graphite);
    font-weight: 500;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
  .pub-desc {
    margin-top: 0.7rem;
    font-size: 0.94rem;
  }
  @media (max-width: 720px) {
    .pub-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
